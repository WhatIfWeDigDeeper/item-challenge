# Server
PORT=3000

# Storage backend (default: in-memory)
USE_DYNAMODB=false
# DynamoDB (required when USE_DYNAMODB=true)
DYNAMODB_TABLE_NAME=ExamItems
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS credentials (required when USE_DYNAMODB=true;
#   not needed if using LocalStack with default credentials)
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=local
AWS_ACCESS_KEY_ID=local
